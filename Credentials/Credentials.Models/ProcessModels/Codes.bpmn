<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_codes_sub" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.36.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.2.0">
  <bpmn:process id="Codes_resolve_sub" name="Codes_resolve_sub" isExecutable="true">
    <bpmn:startEvent id="StartCodes" name="StartCodes">
      <bpmn:outgoing>Flow_start_to_dmn</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_start_to_dmn" sourceRef="StartCodes" targetRef="Activity_codes_dmn" />
    <bpmn:businessRuleTask id="Activity_codes_dmn" name="Codes DMN">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="CodesDMN" resultVariable="dmnResult" />
        <zeebe:ioMapping>
          <zeebe:input source="=if (is defined(project)) then project else &#34;&#34;" target="project" />
          <zeebe:input source="=if (is defined(taskId)) then taskId else &#34;&#34;" target="taskId" />
        </zeebe:ioMapping>
        <zeebe:properties />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_start_to_dmn</bpmn:incoming>
      <bpmn:outgoing>Flow_dmn_to_add</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=if (is defined(codes)) then codes else []" inputElement="code" outputCollection="resolvedCodes" outputElement="={ code: code, result: dmnResult }" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="Flow_dmn_to_add" sourceRef="Activity_codes_dmn" targetRef="Activity_add_codes" />
    <bpmn:serviceTask id="Activity_add_codes" name="Add Codes to Vault Project">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="add-codes-to-vault" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_dmn_to_add</bpmn:incoming>
      <bpmn:outgoing>Flow_add_to_move</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_add_to_move" sourceRef="Activity_add_codes" targetRef="Activity_move_secrets" />
    <bpmn:serviceTask id="Activity_move_secrets" name="Move Secret Ones to Project Vault">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="move-secret-codes-to-vault" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_add_to_move</bpmn:incoming>
      <bpmn:outgoing>Flow_move_to_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_move_to_end" sourceRef="Activity_move_secrets" targetRef="Event_codes_end" />
    <bpmn:endEvent id="Event_codes_end">
      <bpmn:incoming>Flow_move_to_end</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_codes">
    <bpmndi:BPMNPlane id="BPMNPlane_codes" bpmnElement="Codes_resolve_sub">
      <bpmndi:BPMNShape id="StartCodes_di" bpmnElement="StartCodes">
        <dc:Bounds x="182" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="172" y="145" width="57" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_codes_dmn_di" bpmnElement="Activity_codes_dmn">
        <dc:Bounds x="270" y="80" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_add_codes_di" bpmnElement="Activity_add_codes">
        <dc:Bounds x="420" y="80" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_move_secrets_di" bpmnElement="Activity_move_secrets">
        <dc:Bounds x="570" y="80" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_codes_end_di" bpmnElement="Event_codes_end">
        <dc:Bounds x="722" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_start_to_dmn_di" bpmnElement="Flow_start_to_dmn">
        <di:waypoint x="218" y="120" />
        <di:waypoint x="270" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_dmn_to_add_di" bpmnElement="Flow_dmn_to_add">
        <di:waypoint x="370" y="120" />
        <di:waypoint x="420" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_add_to_move_di" bpmnElement="Flow_add_to_move">
        <di:waypoint x="520" y="120" />
        <di:waypoint x="570" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_move_to_end_di" bpmnElement="Flow_move_to_end">
        <di:waypoint x="670" y="120" />
        <di:waypoint x="722" y="120" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
