@using FiveSafesTes.Core.Models.ViewModels
@model FiveSafesTes.Core.Models.ViewModels.ProjectUserTre
@{
    string pageName = Model.Name;

    ViewData["Title"] = @pageName + " - GraphQL TES Wizard";
    int pId = Model.Id;
}
<div class="container-lg mt-4 p-4 bg-white border-1 shadow-sm">
    @if (Model.ProjectType != FiveSafesTes.Core.Models.ProjectType.Tes)
    {
        <div class="alert alert-info">
            <i class="fa fa-info-circle me-2"></i>
            This project is configured for @Model.ProjectType access and cannot make TES submissions.
        </div>
    }
    else if (ViewBag.UserCanDoSubmissions)
{
    @await Component.InvokeAsync("SubmissionWizardRawGraphQL", new {projectId=pId})
}
</div>
