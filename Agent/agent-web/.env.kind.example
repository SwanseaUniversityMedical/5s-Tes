# Copy to .env.local to run agent-web from the host against the kind cluster's
# agent dependencies (see root README "Running apps from VS Code against kind").
# Values are the agent-devstack chart's fixed dev Secrets/realm (devstack is the
# documented dev/prod interface) - see charts/agent-devstack/templates/secrets/static.yaml
# and templates/keycloak-realm.yaml.

BETTER_AUTH_SECRET="dev-agent-betterauth-secret-fixed-32c"
BETTER_AUTH_URL=http://localhost:3000
KEYCLOAK_CLIENT_ID=Dare-TRE-UI
KEYCLOAK_CLIENT_SECRET=devsecret-tre-ui
KEYCLOAK_URL=http://keycloak.agent.localtest.me
NEXT_PUBLIC_KEYCLOAK_REALM=Dare-TRE
NEXT_PUBLIC_KEYCLOAK_URL=http://keycloak.agent.localtest.me
NEXT_PUBLIC_HELPDESK_URL=https://ukserp.atlassian.net/servicedesk/customer/portal/3
# In-cluster Agent.Api via ingress. Point at http://localhost:5269 instead if
# Agent.Api is also running on the host against its own _Kind profile.
AGENT_API_URL=http://agent-api.agent.localtest.me
